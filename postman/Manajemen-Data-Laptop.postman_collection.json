{
  "info": {
    "name": "Manajemen Data Laptop - MongoDB REST API",
    "description": "Postman collection untuk menguji REST API Manajemen Data Laptop berbasis MongoDB. Pastikan MongoDB aktif, file .env sudah diatur, dan server berjalan. Request POST otomatis menyimpan _id ke variable laptopId untuk request GET by ID, PUT, dan DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/"
        }
      }
    },
    {
      "name": "GET - Semua Laptop",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/laptops"
        }
      }
    },
    {
      "name": "POST - Tambah Laptop",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  if (data._id) pm.collectionVariables.set('laptopId', data._id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merk_laptop\": \"ASUS\",\n  \"processor\": \"Intel Core i5\",\n  \"harga\": 8500000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/laptops"
        }
      }
    },
    {
      "name": "GET - Laptop Berdasarkan ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/laptops/{{laptopId}}"
        }
      }
    },
    {
      "name": "PUT - Ubah Laptop",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merk_laptop\": \"ASUS\",\n  \"processor\": \"Intel Core i7\",\n  \"harga\": 12000000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/laptops/{{laptopId}}"
        }
      }
    },
    {
      "name": "DELETE - Hapus Laptop",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/laptops/{{laptopId}}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "laptopId",
      "value": ""
    }
  ]
}